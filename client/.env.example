# Base URL of the SlayGreen API. Leave unset to use the Vite dev proxy (/api/v1).
VITE_API_BASE_URL=/api/v1

# Stripe publishable key is fetched from the backend at runtime, but you can
# override it here for local testing if you prefer.
# VITE_STRIPE_PUBLISHABLE_KEY=

# Optional contact details shown on the Contact page and in the footer.
# Anything left empty is simply not displayed.
# VITE_CONTACT_EMAIL=hello@example.com
# VITE_CONTACT_PHONE=+00 00000 00000
# VITE_CONTACT_ADDRESS=Your business address
# VITE_SOCIAL_INSTAGRAM=https://instagram.com/yourhandle
# VITE_SOCIAL_LINKEDIN=https://linkedin.com/company/yourcompany
# VITE_SOCIAL_X=https://x.com/yourhandle
